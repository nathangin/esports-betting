# Copy this to .env and fill in your keys

# SQLite by default — switch to postgres for production
DATABASE_URL=sqlite:///data/esports.db

# Set to true if HLTV blocks plain requests (requires: playwright install chromium)
USE_PLAYWRIGHT=false

# PandaScore API — optional higher-quality data source
PANDASCORE_TOKEN=

# Riot API key — for LoL supplementary data
RIOT_API_KEY=
